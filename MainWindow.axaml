                                <ComboBoxItem Content="DRAGOON=189" />
                                <ComboBoxItem Content="CARBINEER=190" />
                                <ComboBoxItem Content="CAMELRANGE2=191" />
                                <ComboBoxItem Content="CAMELRANGE3=192" />
