<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:x2_prototype"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1020" d:DesignHeight="860"
        x:Class="x2_prototype.MainWindow"
        x:DataType="local:MainWindow"
        Title="X2 Mod Tools Prototype"
        Width="1020"
        Height="860"
        MinWidth="1020"
        MinHeight="860"
        Background="WhiteSmoke"
        TextElement.FontFamily="{StaticResource DefaultFont}">

    <!-- definitions for the data templates for binding etc -->
    <Window.DataTemplates>
        <DataTemplate DataType="local:CbpItem" x:DataType="local:CbpItem">
            <Border Padding="10,8" Margin="0,0,0,0" BorderBrush="Gray" BorderThickness="1" Background="WhiteSmoke">
                <Grid ColumnDefinitions="5, *">
                    <Rectangle Grid.Column="0" Grid.RowSpan="2" Margin="-10,-8,10,-8">
                        <Rectangle.Fill>
                            <SolidColorBrush Color="LightSkyBlue" />
                        </Rectangle.Fill>
                    </Rectangle>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding Version}" FontWeight="Bold" />
                        <TextBlock Text="The exe includes changes from this game version as its baseline."/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="local:ReassignmentItem" x:DataType="local:ReassignmentItem">
            <Border Padding="10,8" Margin="0,0,0,0" BorderBrush="Gray" BorderThickness="1" Background="White">
                <Grid ColumnDefinitions="5, *,Auto" RowDefinitions="Auto, Auto">
                    <Rectangle Grid.Column="0" Grid.RowSpan="2" Margin="-10,-8,10,-8">
                        <Rectangle.Fill>
                            <SolidColorBrush Color="Gold" />
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding AssignmentPower}" FontWeight="Bold" />
                    <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{Binding AssignmentType}" />
                        <TextBlock Text="assignment to:"/>
                        <TextBlock Text="{Binding AssignmentNation, Converter={StaticResource TrimSuffix}}" />
                    </StackPanel>
                    <Button Grid.Column="1" Grid.RowSpan="2" Content="✖" Background="DarkSalmon" Click="RemoveEntry_Click" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="local:AsmBlockItem" x:DataType="local:AsmBlockItem">
            <Border Padding="10,8" Margin="0,0,0,0" BorderBrush="Gray" BorderThickness="1" Background="White">
                <Grid ColumnDefinitions="5, *, Auto" RowDefinitions="Auto, Auto">
                    <Rectangle Grid.Column="0" Grid.RowSpan="2" Margin="-10,-8,10,-8">
                        <Rectangle.Fill>
                            <SolidColorBrush Color="YellowGreen" />
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding AsmBlockType}" FontWeight="Bold" />
                        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Spacing="20">
                            <TextBlock Text="{Binding AsmNation, Converter={StaticResource TrimSuffix}, StringFormat='Assigned to: {0}'}" />
                            <TextBlock Text="{Binding AsmUnit, Converter={StaticResource TrimSuffix}, StringFormat='X: {0}'}" IsVisible="{Binding UsesX}"/>
                            <TextBlock Text="{Binding AsmValue, Converter={StaticResource TrimSuffix}, StringFormat='Y: {0}%'}" IsVisible="{Binding UsesY}" />
                            <TextBlock Text="{Binding AsmTech, Converter={StaticResource TrimSuffix}, StringFormat='Z1: {0}'}" IsVisible="{Binding UsesZ1}" />
                            <TextBlock Text="{Binding AsmBuilding, Converter={StaticResource TrimSuffix}, StringFormat='Z2: {0}'}" IsVisible="{Binding UsesZ2}" />
                        </StackPanel>
                    <Button Grid.Column="2" Grid.RowSpan="2" Content="✖" Background="DarkSalmon" Click="RemoveEntry_Click" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Resources>
        <local:TrimSuffixConverter x:Key="TrimSuffix"/>
    </Window.Resources>

    <Window.Styles>
      <Style Selector="Button">
      <!-- for some reason the override is a pita https://docs.avaloniaui.net/troubleshooting/ui-development/styles -->
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="LightCyan" />
          <Setter Property="BorderBrush" Value="LightSlateGray" />
          <Setter Property="BorderThickness" Value="1" />
        </Style>
      </Style>
    </Window.Styles>

    <!-- The actual UI itself -->
    <Grid ColumnDefinitions="420, *">

        <!-- left side: controls for adding new stuff -->
        <StackPanel>
            <TextBlock Text="Add Changes" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>

            <!-- wrapped in border since stackpanel doesn't support padding -->
            <Border Padding="15" Grid.Column="0">
                <StackPanel Spacing="0">
                    <TextBlock Text="Reassign existing nation power" FontSize="18" FontWeight="Bold" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="Assignment type" />
                        <TextBlock Text="ⓘ" Padding="4,0" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Background="WhiteSmoke" 
                            ToolTip.Tip="Normal assignment gives the selected power to the selected nation. Reverse-assignment gives the selected power to all nations other than the selected nation. Reverse-assigning a power to No Nation gives the selected power to all nations." ToolTip.Placement="Right" />
                    </StackPanel>
                    <ComboBox x:Name="AssignmentTypeCombo" SelectedIndex="0" Background="White" Width="100">
                        <ComboBoxItem Content="Normal" />
                        <ComboBoxItem Content="Reverse" />
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="Nation" />
                        <TextBlock Text="ⓘ" Padding="4,0" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Background="WhiteSmoke" 
                            ToolTip.Tip="Nations are listed in internal game order." ToolTip.Placement="Right" />
                    </StackPanel>
                    <ComboBox x:Name="AssignmentNationCombo" SelectedIndex="0" Background="White" Width="160">
                        <ComboBoxItem Content="AZTECS = 0x00" />
                        <ComboBoxItem Content="MAYA = 0x01" />
                        <ComboBoxItem Content="INCA = 0x02" />
                        <ComboBoxItem Content="BANTU = 0x03" />
                        <ComboBoxItem Content="NUBIANS = 0x04" />
                        <ComboBoxItem Content="GREEKS = 0x05" />
                        <ComboBoxItem Content="ROMANS = 0x06" />
                        <ComboBoxItem Content="EGYPTIANS = 0x07" />
                        <ComboBoxItem Content="TURKS = 0x08" />
                        <ComboBoxItem Content="SPANISH = 0x09" />
                        <ComboBoxItem Content="FRENCH = 0x0A" />
                        <ComboBoxItem Content="BRITISH = 0x0B" />
                        <ComboBoxItem Content="GERMANS = 0x0C" />
                        <ComboBoxItem Content="RUSSIANS = 0x0D" />
                        <ComboBoxItem Content="CHINESE = 0x0E" />
                        <ComboBoxItem Content="JAPANESE = 0x0F" />
                        <ComboBoxItem Content="KOREANS = 0x10" />
                        <ComboBoxItem Content="MONGOLS = 0x11" />
                        <ComboBoxItem Content="IROQUOIS = 0x12" />
                        <ComboBoxItem Content="LAKOTA = 0x13" />
                        <ComboBoxItem Content="AMERICANS = 0x14" />
                        <ComboBoxItem Content="INDIANS = 0x15" />
                        <ComboBoxItem Content="DUTCH = 0x16" />
                        <ComboBoxItem Content="PERSIANS = 0x17" />
                        <ComboBoxItem Content="NO_NATION = 0x69" />
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="Nation power type" />
                        <TextBlock Text="ⓘ" Padding="4,0" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Background="WhiteSmoke" 
                            ToolTip.Tip="Nation sub-powers that are part of a nation power group (e.g., those with A and B parts) should be assigned to the same nation to replicate in-game behaviour. Splitting these assignments across different nations can lead to interesting or buggy-feeling results depending on the nation power." ToolTip.Placement="Right" />
                    </StackPanel>
                    <ComboBox x:Name="NationPowerCombo" SelectedIndex="0" Background="White" Width="240">
                        <ComboBoxItem Content="Bantu city cost" />
                        <ComboBoxItem Content="Bantu city limit (A)" />
                        <ComboBoxItem Content="Bantu city limit (B)" />
                        <ComboBoxItem Content="Bantu pop cap / final pop cap" />
                        <ComboBoxItem Content="Bantu unit upgrades" />
                        <ComboBoxItem Content="Bantu units move" />
                        <ComboBoxItem Content="Chinese citizen creation / instant" />
                        <ComboBoxItem Content="Chinese herbal lore" />
                        <ComboBoxItem Content="Chinese knowledge upgrades" />
                        <ComboBoxItem Content="Chinese large city / cities (A)" />
                        <ComboBoxItem Content="Chinese large city / cities (B)" />
                        <ComboBoxItem Content="Chinese large city / cities (C)" />
                        <ComboBoxItem Content="Chinese large city / cities (D)" />
                        <ComboBoxItem Content="Chinese science discount" />
                        <ComboBoxItem Content="Chinese light infantry [CBP]" />
                        <ComboBoxItem Content="Persians bonus food (A)" />
                        <ComboBoxItem Content="Persians bonus food (B)" />
                        <ComboBoxItem Content="Persians capitals (A)" />
                        <ComboBoxItem Content="Persians capitals (B)" />
                        <ComboBoxItem Content="Persians capitals (C)" />
                        <ComboBoxItem Content="Persians capitals (D)" />
                        <ComboBoxItem Content="Persians capitals (E)" />
                        <ComboBoxItem Content="Persians capitals (F)" />
                        <ComboBoxItem Content="Persians capitals (G)" />
                        <ComboBoxItem Content="Persians capitals (H)" />
                        <ComboBoxItem Content="Persians capitals (I)" />
                        <ComboBoxItem Content="Persians caravans" />
                        <ComboBoxItem Content="Persians civic discount" />
                        <ComboBoxItem Content="Persians despotism (A)" />
                        <ComboBoxItem Content="Persians despotism (B)" />
                        <ComboBoxItem Content="Persians taxation" />
                        <ComboBoxItem Content="Persian capitals worldgov fix [CBP]" />
                        <ComboBoxItem Content="Persian cheaper conv missiles [CBP]" />
                        <ComboBoxItem Content="Persian faster conv missiles [CBP]" />
                    </ComboBox>

                    <Button Content="Reassign nation power"
                            HorizontalAlignment="Center"
                            Margin="0,26,0,0"
                            Background="Bisque"
                            BorderBrush="Tan"
                            BorderThickness="1"
                            Click="AddReassignment_Click" />
                </StackPanel>
            </Border>

            <Separator Margin="10,10,10,10"/>

            <!-- ..each parent border only supports one child, so we need a separate second border->stackpanel here -->
            <Border Grid.Column="0" Padding="15">
                <StackPanel Spacing="0">
                    <TextBlock Text="Add new nation power"
                        FontSize="18"
                        FontWeight="Bold" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0" >
                         <TextBlock Text="New nation power"/>
                         <TextBlock Text="ⓘ" Padding="4,0" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Background="WhiteSmoke" 
                            ToolTip.Tip="X/Y/Z values are only used when relevant to the selection. Nation power rules follow RoN norms: cheaper is base cost, %faster is not %reduction, free starting stuff doesn't work in nomad." ToolTip.Placement="Right" />
                    </StackPanel>
                    <ComboBox x:Name="AsmBlockTypeCombo" SelectedIndex="0" Background="White" Width="240">
                        <ComboBoxItem Content="X unit is Y% cheaper to build" />
                        <ComboBoxItem Content="X unit is Y% faster to build" />
                        <!--<ComboBoxItem Content="Get Z tech automatically and for free" />--><!-- it turns out that I would need two tech params here - the implementation has tech bookends and gives you everything between them -->
                        <ComboBoxItem Content="Start game with X unit" />
                        <ComboBoxItem Content="Start game with Z1 tech" />
                        <ComboBoxItem Content="Start game with Z2 building" />
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="Nation" />
                        <TextBlock Text="ⓘ" Padding="4,0" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Background="WhiteSmoke" 
                            ToolTip.Tip="Nations are listed in internal game order." ToolTip.Placement="Right" />
                    </StackPanel>
                    <ComboBox x:Name="AsmBlockNationCombo" SelectedIndex="0" Background="White" Width="160">
                        <ComboBoxItem Content="AZTECS = 0x00" />
                        <ComboBoxItem Content="MAYA = 0x01" />
                        <ComboBoxItem Content="INCA = 0x02" />
                        <ComboBoxItem Content="BANTU = 0x03" />
                        <ComboBoxItem Content="NUBIANS = 0x04" />
                        <ComboBoxItem Content="GREEKS = 0x05" />
                        <ComboBoxItem Content="ROMANS = 0x06" />
                        <ComboBoxItem Content="EGYPTIANS = 0x07" />
                        <ComboBoxItem Content="TURKS = 0x08" />
                        <ComboBoxItem Content="SPANISH = 0x09" />
                        <ComboBoxItem Content="FRENCH = 0x0A" />
                        <ComboBoxItem Content="BRITISH = 0x0B" />
                        <ComboBoxItem Content="GERMANS = 0x0C" />
                        <ComboBoxItem Content="RUSSIANS = 0x0D" />
                        <ComboBoxItem Content="CHINESE = 0x0E" />
                        <ComboBoxItem Content="JAPANESE = 0x0F" />
                        <ComboBoxItem Content="KOREANS = 0x10" />
                        <ComboBoxItem Content="MONGOLS = 0x11" />
                        <ComboBoxItem Content="IROQUOIS = 0x12" />
                        <ComboBoxItem Content="LAKOTA = 0x13" />
                        <ComboBoxItem Content="AMERICANS = 0x14" />
                        <ComboBoxItem Content="INDIANS = 0x15" />
                        <ComboBoxItem Content="DUTCH = 0x16" />
                        <ComboBoxItem Content="PERSIANS = 0x17" />
                        <ComboBoxItem Content="NO_NATION = 0x69" />
                    </ComboBox>

                    <Grid ColumnDefinitions="280, 20, 60, *" RowDefinitions="*, *, *">
                        <StackPanel Grid.Column="0" >
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0" >
                                <TextBlock Text="X: Unit"/>
                                 <TextBlock Text="ⓘ" Padding="4,0" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Background="WhiteSmoke" 
                                    ToolTip.Tip="Unit names currently per internal naming, which doesn't completely match in-game names. Unit selection includes grafts and upgrades. For example, selecting Slingers will affect all Light Infantry (plus Gunpowder Infantry and Modern Infantry)." ToolTip.Placement="Right" />
                            </StackPanel>
                            <ComboBox x:Name="AsmBlockUnitCombo" SelectedIndex="0" Background="White" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="PEASANTS=50" />
                                <ComboBoxItem Content="PEASANTSKOREAN=51" />
                                <ComboBoxItem Content="SCHOLARS=52" />
                                <ComboBoxItem Content="SCHOLARSKOREAN=53" />
                                <ComboBoxItem Content="GENERAL=54" />
                                <ComboBoxItem Content="GENERALCTWE=55" />
                                <ComboBoxItem Content="GENERALCTWW=56" />
                                <ComboBoxItem Content="GENERALGERMAN=57" />
                                <ComboBoxItem Content="SPY=58" />
                                <ComboBoxItem Content="CARA=59" />
                                <ComboBoxItem Content="CARADUTCH=60" />
                                <ComboBoxItem Content="MERCHANT=61" />
                                <ComboBoxItem Content="MERCHANTDUTCH=62" />
                                <ComboBoxItem Content="SUPPLYWAGON=63" />
