        <!-- right side (you are king) -->
        <Grid Grid.Column="1" RowDefinitions="*, 200">
            <!-- a list of stuff that's been added -->
            <Grid Grid.Row="0" RowDefinitions="Auto, *" Background="Gainsboro">
                <TextBlock Grid.Row="0" Text="Currently Selected Changes" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center" Margin="0,10,0,10"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding Entries}" Background="Gainsboro" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.AllowAutoHide="False">
                    <!-- Otherwise the implicit padding makes the list take up too much space vertically -->
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="8,3"/>
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </Grid>

            <!-- Adapted I/O controls from mechcommander mantis project -->
            <StackPanel Grid.Row="1">
                <StackPanel Margin="0,5,0,0">
                    <TextBlock Text="RoN exe path (input)" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Grid>
                        <!-- 2-column grids replacing horizontal stack panels so that the textboxes fill available width -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Width="70" Content="Browse..." Background="Linen" BorderBrush="Tan" BorderThickness="1" Click="BrowseInput_Click" FontSize="13"/>
                        <TextBox Grid.Column="1" Name="InputExeTextBox" Text="File path of Rise of Nations CBPa11 exe (e.g., riseofnations_CBPa11.exe)..." FontSize="12" FontWeight="Regular" Margin="5,0,10,0" VerticalAlignment="Top" IsEnabled="False"/>
                    </Grid>
                </StackPanel>
                <StackPanel Margin="0,5,0,0">
                    <TextBlock Text="Patched exe patch (output)" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Grid>
                        <!-- 2-column grids replacing horizontal stack panels so that the textboxes fill available width -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Width="70" Content="Browse..." Background="Linen" BorderBrush="Tan" BorderThickness="1" Click="BrowseOutput_Click" FontSize="13"/>
                        <TextBox Grid.Column="1" Name="OutputExeTextBox" Text="File path for the patched exe (e.g., riseofnations_X2.exe)..." FontSize="12" FontWeight="Regular" Margin="5,0,10,0" VerticalAlignment="Top" IsEnabled="False"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                    </StackPanel>
                </StackPanel>
                <Button Name="PatchButton" 
                        Margin="0,15,0,0" 
                        FontSize="16" 
                        FontWeight="Bold" 
                        Width=""
                        Height="34" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Background="Bisque"
                        BorderBrush="Tan"
                        BorderThickness="2"
                        Click="SaveButton_Click" >
                    <Button.Content>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">Save patched exe</TextBlock>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
