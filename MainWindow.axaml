                                <ComboBoxItem Content="SUPPLYWAGONDUTCH=65" />
                                <ComboBoxItem Content="MILITIA=66" />
                                <ComboBoxItem Content="MINUTEMAN=67" />
                                <ComboBoxItem Content="PARTISAN=68" />
                                <ComboBoxItem Content="SCOUT=69" />
