                                <ComboBoxItem Content="HVYMACHINEGUNMG42=130" />
                                <ComboBoxItem Content="FLAMETHROWER=131" />
                                <ComboBoxItem Content="HOPLITES=132" />
                                <ComboBoxItem Content="PHALANX=133" />
